# Private working notes (local paths, personal references). Never commit.
HANDOFF.md
*.private.md

# Claude Code project config (settings, local settings, runtime files). This
# repo shares none of it; the mod's own manifest is .claude-plugin/, kept.
**/.claude/

# Environment and secrets. An env template is named env.example (no leading
# dot, so it stays visible); these rules never match it.
.env
.env.*
*.pem
*.key

# Dependencies and build output
node_modules/
dist/
coverage/

# OS and editor
.DS_Store
*.log
.vscode/
.idea/

# Private-info guard patterns (personal identifiers). Never commit.
.private-patterns

# Session notes and logs written by local Claude Code plugins. Never commit.
.remember/
logs/

# Types the engine lays beside a loaded mod: they list this machine's
# connected MCP tools. Regenerated on every load.
**/.claude-plugin/types/
